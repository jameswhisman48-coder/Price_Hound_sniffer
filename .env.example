# Copy this file to .env and fill in the real values. .env is gitignored — never
# commit real credentials. The Kroger client module (src/lib/kroger-client.ts)
# reads these at runtime (Bun auto-loads .env); if they are absent it falls back
# to parsing /home/team/shared/kroger-api-credentials.md (team-internal only).
#
# Get these from the Kroger Developer Portal (developer.kroger.com) → your app.
# Scope used by PriceHound: product.compact (the only scope granted to this app).
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Optional guard for the manual refresh endpoint. If set, POST /api/prices/refresh
# requires header `Authorization: Bearer <value>`. If unset, the endpoint is open
# (pilot phase). The CLI (`bun run prices:refresh`) never uses this key — it runs
# server-side on the machine itself.
# PRICES_REFRESH_KEY=
